# dc2-leaf - SR Linux 26.7.1. Flat startup CLI; no enter/commit needed.
set / system name host-name dc2-leaf
set / interface system0 admin-state enable
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.2.1/32
set / network-instance default admin-state enable
set / network-instance default interface system0.0
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 mtu 9216
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ip-mtu 9000
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 100.64.2.1/31
set / network-instance default interface ethernet-1/1.0
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.1/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.254/32 mask-length-range exact
set / routing-policy policy UNDERLAY default-action policy-result reject
set / routing-policy policy UNDERLAY statement 10 match prefix prefix-set UNDERLAY
set / routing-policy policy UNDERLAY statement 10 action policy-result accept
set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system 65102
set / network-instance default protocols bgp router-id 10.255.2.1
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group UNDERLAY admin-state enable
set / network-instance default protocols bgp group UNDERLAY afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group UNDERLAY afi-safi evpn admin-state disable
set / network-instance default protocols bgp group UNDERLAY import-policy [ UNDERLAY ]
set / network-instance default protocols bgp group UNDERLAY export-policy [ UNDERLAY ]
set / network-instance default protocols bgp neighbor 100.64.2.0 admin-state enable
set / network-instance default protocols bgp neighbor 100.64.2.0 peer-group UNDERLAY
set / network-instance default protocols bgp neighbor 100.64.2.0 peer-as 65000
set / routing-policy policy EVPN-ACCEPT default-action policy-result accept
set / network-instance default protocols bgp afi-safi evpn admin-state enable
set / network-instance default protocols bgp group OVERLAY admin-state enable
set / network-instance default protocols bgp group OVERLAY afi-safi evpn admin-state enable
set / network-instance default protocols bgp group OVERLAY afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group OVERLAY import-policy [ EVPN-ACCEPT ]
set / network-instance default protocols bgp group OVERLAY export-policy [ EVPN-ACCEPT ]
set / network-instance default protocols bgp neighbor 10.255.2.254 admin-state enable
set / network-instance default protocols bgp neighbor 10.255.2.254 peer-group OVERLAY
set / network-instance default protocols bgp neighbor 10.255.2.254 peer-as 65000
set / network-instance default protocols bgp neighbor 10.255.2.254 transport local-address 10.255.2.1
# L2: untagged access port into the stretched broadcast domain, no IRB.
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 type bridged
set / tunnel-interface vxlan0 vxlan-interface 10 type bridged
set / tunnel-interface vxlan0 vxlan-interface 10 ingress vni 10010
set / network-instance L2-10 type mac-vrf
set / network-instance L2-10 admin-state enable
set / network-instance L2-10 interface ethernet-1/2.0
set / network-instance L2-10 vxlan-interface vxlan0.10
set / network-instance L2-10 protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance L2-10 protocols bgp-evpn bgp-instance 1 evi 10
set / network-instance L2-10 protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan0.10
set / network-instance L2-10 protocols bgp-vpn bgp-instance 1 route-distinguisher rd 10.255.2.1:10
set / network-instance L2-10 protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:10010
set / network-instance L2-10 protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:10010
# L3: local BD-30 has no VXLAN mapping; only the IP-VRF crosses DCI.
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 type bridged
set / interface irb0 admin-state enable
set / interface irb0 subinterface 30 admin-state enable
set / interface irb0 subinterface 30 ip-mtu 1500
set / interface irb0 subinterface 30 ipv4 admin-state enable
set / interface irb0 subinterface 30 ipv4 address 192.168.30.1/24 anycast-gw true
set / interface irb0 subinterface 30 anycast-gw anycast-gw-mac 00:00:5e:00:01:01
set / network-instance BD-30 type mac-vrf
set / network-instance BD-30 admin-state enable
set / network-instance BD-30 interface ethernet-1/3.0
set / network-instance BD-30 interface irb0.30
set / tunnel-interface vxlan0 vxlan-interface 50000 type routed
set / tunnel-interface vxlan0 vxlan-interface 50000 ingress vni 50000
set / network-instance TENANT type ip-vrf
set / network-instance TENANT admin-state enable
set / network-instance TENANT interface irb0.30
set / network-instance TENANT vxlan-interface vxlan0.50000
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 evi 50000
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan0.50000
set / network-instance TENANT protocols bgp-evpn bgp-instance 1 routes route-table mac-ip advertise-gateway-mac true
set / network-instance TENANT protocols bgp-vpn bgp-instance 1 route-distinguisher rd 10.255.2.1:50000
set / network-instance TENANT protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:50000
set / network-instance TENANT protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:50000
set / network-instance default protocols bgp group OVERLAY multihop admin-state enable
set / network-instance default protocols bgp group OVERLAY multihop maximum-hops 2
