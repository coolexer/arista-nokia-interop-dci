# dc2-bl2 - SR Linux 26.7.1. Flat startup CLI; no enter/commit needed.
set / system name host-name dc2-bl2
set / interface system0 admin-state enable
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.2.253/32
set / network-instance default admin-state enable
set / network-instance default interface system0.0
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 mtu 9216
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ip-mtu 9000
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 100.64.2.2/31
set / network-instance default interface ethernet-1/1.0
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 mtu 9216
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ip-mtu 9000
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 100.64.12.3/31
set / network-instance default interface ethernet-1/2.0
set / routing-policy prefix-set UNDERLAY prefix 10.255.1.1/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.1/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.1.254/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.253/32 mask-length-range exact
set / routing-policy policy UNDERLAY default-action policy-result reject
set / routing-policy policy UNDERLAY statement 10 match prefix prefix-set UNDERLAY
set / routing-policy policy UNDERLAY statement 10 action policy-result accept
set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system 65212
set / network-instance default protocols bgp router-id 10.255.2.253
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group UNDERLAY admin-state enable
set / network-instance default protocols bgp group UNDERLAY afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group UNDERLAY afi-safi evpn admin-state disable
set / network-instance default protocols bgp group UNDERLAY import-policy [ UNDERLAY ]
set / network-instance default protocols bgp group UNDERLAY export-policy [ UNDERLAY ]
set / network-instance default protocols bgp neighbor 100.64.2.3 admin-state enable
set / network-instance default protocols bgp neighbor 100.64.2.3 peer-group UNDERLAY
set / network-instance default protocols bgp neighbor 100.64.2.3 peer-as 65102
set / network-instance default protocols bgp neighbor 100.64.12.2 admin-state enable
set / network-instance default protocols bgp neighbor 100.64.12.2 peer-group UNDERLAY
set / network-instance default protocols bgp neighbor 100.64.12.2 peer-as 65211
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 mtu 9216
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ip-mtu 9000
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 100.64.2.2/31
set / network-instance default interface ethernet-1/1.0
set / bfd subinterface ethernet-1/1.0 admin-state enable
set / bfd subinterface ethernet-1/1.0 desired-minimum-transmit-interval 500000
set / bfd subinterface ethernet-1/1.0 required-minimum-receive 500000
set / bfd subinterface ethernet-1/1.0 detection-multiplier 3
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 mtu 9216
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ip-mtu 9000
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 100.64.12.3/31
set / network-instance default interface ethernet-1/2.0
set / bfd subinterface ethernet-1/2.0 admin-state enable
set / bfd subinterface ethernet-1/2.0 desired-minimum-transmit-interval 500000
set / bfd subinterface ethernet-1/2.0 required-minimum-receive 500000
set / bfd subinterface ethernet-1/2.0 detection-multiplier 3
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 mtu 9216
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 ip-mtu 9000
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 100.64.102.1/31
set / network-instance default interface ethernet-1/3.0
set / bfd subinterface ethernet-1/3.0 admin-state enable
set / bfd subinterface ethernet-1/3.0 desired-minimum-transmit-interval 500000
set / bfd subinterface ethernet-1/3.0 required-minimum-receive 500000
set / bfd subinterface ethernet-1/3.0 detection-multiplier 3
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath allow-multiple-as true
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath ebgp maximum-paths 2
set / network-instance default protocols bgp group UNDERLAY failure-detection enable-bfd true
set / network-instance default protocols bgp neighbor 100.64.102.0 admin-state enable
set / network-instance default protocols bgp neighbor 100.64.102.0 peer-group UNDERLAY
set / network-instance default protocols bgp neighbor 100.64.102.0 peer-as 65202
set / routing-policy prefix-set UNDERLAY prefix 10.255.1.253/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.253/32 mask-length-range exact
set / network-instance default ip-load-balancing resilient-hash-prefix 10.255.0.0/16 max-paths 2
