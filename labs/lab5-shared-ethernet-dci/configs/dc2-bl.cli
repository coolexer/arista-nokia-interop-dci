# Lab 5: Nokia X1b EVPN all-active ES, native L2 handoff and tenant L3 transit.
set / system name host-name dc2-bl
set / network-instance default admin-state enable
set / interface system0 admin-state enable
set / interface system0 subinterface 0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.2.254/32
set / network-instance default interface system0.0
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 mtu 9216
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 mtu 9216
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 100.64.2.0/31
set / network-instance default interface ethernet-1/1.0
set / interface ethernet-1/1 subinterface 0 ip-mtu 9000
set / bfd subinterface ethernet-1/1.0 admin-state enable
set / bfd subinterface ethernet-1/1.0 desired-minimum-transmit-interval 500000
set / bfd subinterface ethernet-1/1.0 required-minimum-receive 500000
set / bfd subinterface ethernet-1/1.0 detection-multiplier 3
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 100.64.102.0/31
set / network-instance default interface ethernet-1/3.0
set / interface ethernet-1/3 subinterface 0 ip-mtu 9000
set / bfd subinterface ethernet-1/3.0 admin-state enable
set / bfd subinterface ethernet-1/3.0 desired-minimum-transmit-interval 500000
set / bfd subinterface ethernet-1/3.0 required-minimum-receive 500000
set / bfd subinterface ethernet-1/3.0 detection-multiplier 3
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.1/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.254/32 mask-length-range exact
set / routing-policy prefix-set UNDERLAY prefix 10.255.2.253/32 mask-length-range exact
set / routing-policy policy UNDERLAY default-action policy-result reject
set / routing-policy policy UNDERLAY statement 10 match prefix prefix-set UNDERLAY
set / routing-policy policy UNDERLAY statement 10 action policy-result accept
set / routing-policy prefix-set DC1-SERVICE prefix 192.168.20.0/24 mask-length-range exact
set / routing-policy policy DC1-SERVICE default-action policy-result reject
set / routing-policy policy DC1-SERVICE statement 10 match prefix prefix-set DC1-SERVICE
set / routing-policy policy DC1-SERVICE statement 10 action policy-result accept
set / routing-policy prefix-set DC2-SERVICE prefix 192.168.30.0/24 mask-length-range exact
set / routing-policy policy DC2-SERVICE default-action policy-result reject
set / routing-policy policy DC2-SERVICE statement 10 match prefix prefix-set DC2-SERVICE
set / routing-policy policy DC2-SERVICE statement 10 action policy-result accept
set / routing-policy policy EVPN-ACCEPT default-action policy-result accept
set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system 65202
set / network-instance default protocols bgp router-id 10.255.2.254
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath allow-multiple-as true
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath ebgp maximum-paths 2
set / network-instance default protocols bgp afi-safi evpn admin-state enable
set / network-instance default protocols bgp group UNDERLAY admin-state enable
set / network-instance default protocols bgp group UNDERLAY afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp group UNDERLAY import-policy [ UNDERLAY ]
set / network-instance default protocols bgp group UNDERLAY export-policy [ UNDERLAY ]
set / network-instance default protocols bgp group UNDERLAY afi-safi evpn admin-state disable
set / network-instance default protocols bgp group UNDERLAY failure-detection enable-bfd true
set / network-instance default protocols bgp neighbor 100.64.2.1 admin-state enable
set / network-instance default protocols bgp neighbor 100.64.2.1 peer-group UNDERLAY
set / network-instance default protocols bgp neighbor 100.64.2.1 peer-as 65102
set / network-instance default protocols bgp neighbor 100.64.102.1 admin-state enable
set / network-instance default protocols bgp neighbor 100.64.102.1 peer-group UNDERLAY
set / network-instance default protocols bgp neighbor 100.64.102.1 peer-as 65202
set / network-instance default protocols bgp neighbor 100.64.102.1 transport local-address 100.64.102.0
set / network-instance default protocols bgp group UNDERLAY next-hop-self true
set / network-instance default protocols bgp group OVERLAY admin-state enable
set / network-instance default protocols bgp group OVERLAY afi-safi evpn admin-state enable
set / network-instance default protocols bgp group OVERLAY import-policy [ EVPN-ACCEPT ]
set / network-instance default protocols bgp group OVERLAY export-policy [ EVPN-ACCEPT ]
set / network-instance default protocols bgp group OVERLAY afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group OVERLAY multihop admin-state enable
set / network-instance default protocols bgp group OVERLAY multihop maximum-hops 8
set / network-instance default protocols bgp neighbor 10.255.2.1 admin-state enable
set / network-instance default protocols bgp neighbor 10.255.2.1 peer-group OVERLAY
set / network-instance default protocols bgp neighbor 10.255.2.1 peer-as 65102
set / network-instance default protocols bgp neighbor 10.255.2.1 transport local-address 10.255.2.254
set / network-instance default protocols bgp neighbor 10.255.2.253 admin-state enable
set / network-instance default protocols bgp neighbor 10.255.2.253 peer-group OVERLAY
set / network-instance default protocols bgp neighbor 10.255.2.253 peer-as 65202
set / network-instance default protocols bgp neighbor 10.255.2.253 transport local-address 10.255.2.254
delete / interface ethernet-1/2 mtu
set / interface ethernet-1/2 ethernet aggregate-id lag1
set / interface lag1 admin-state enable
set / interface lag1 mtu 9216
set / interface lag1 vlan-tagging true
set / interface lag1 lag lag-type lacp
set / interface lag1 lag member-speed 100G
set / interface lag1 lag lacp lacp-mode ACTIVE
set / interface lag1 lag lacp interval FAST
set / interface lag1 lag lacp admin-key 100
set / interface lag1 lag lacp system-id-mac 02:00:00:02:00:aa
set / interface lag1 lag lacp system-priority 32768
set / interface lag1 subinterface 10 admin-state enable
set / interface lag1 subinterface 10 type bridged
set / interface lag1 subinterface 10 l2-mtu 9000
set / interface lag1 subinterface 10 vlan encap single-tagged vlan-id 10
set / interface lag1 subinterface 901 admin-state enable
set / interface lag1 subinterface 901 type bridged
set / interface lag1 subinterface 901 l2-mtu 9000
set / interface lag1 subinterface 901 vlan encap single-tagged vlan-id 901
set / system network-instance protocols bgp-vpn bgp-instance 1
set / system mpls label-ranges dynamic ES-LABELS start-label 21000
set / system mpls label-ranges dynamic ES-LABELS end-label 21999
set / system mpls services evpn dynamic-label-block ES-LABELS
